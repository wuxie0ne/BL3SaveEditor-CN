<Application x:Class="BL3SaveEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BL3SaveEditor"
             xmlns:loc="clr-namespace:BL3SaveEditor.Localization"
             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="./Localization/zh-CN/Strings.xaml" />
                <ResourceDictionary Source="pack://application:,,,/AdonisUI;component/ColorSchemes/Dark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/AdonisUI.ClassicTheme;component/Resources.xaml"/>
                <ResourceDictionary Source="./Styles/WPFToolkit_Adonis.xaml" />


            </ResourceDictionary.MergedDictionaries>
            <loc:GameNameConverter x:Key="GameNameConverter" />
            <DataTemplate x:Key="GameAssetTemplate">
                <TextBlock Text="{Binding Converter={StaticResource GameNameConverter}, ConverterParameter=asset}"
                           ToolTip="{Binding Converter={StaticResource GameNameConverter}, ConverterParameter=asset}" />
            </DataTemplate>
            <DataTemplate x:Key="GameNameTemplate">
                <TextBlock Text="{Binding Converter={StaticResource GameNameConverter}, ConverterParameter=names}" />
            </DataTemplate>
            <DataTemplate x:Key="GameTypeTemplate">
                <TextBlock Text="{Binding Converter={StaticResource GameNameConverter}, ConverterParameter=types}" />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
